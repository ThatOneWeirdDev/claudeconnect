{
  "name": "claudeconnect",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "description": "Use Claude Code from any browser, through a site that only you can open.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/release.mjs --check && node --test \"test/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/*.test.mjs\"",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "miniflare": "^4.20250906.0"
  },
  "bin": {
    "claudeconnect": "ClaudeConnect.mjs"
  }
}
